{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sp500-quant-signal",
  "account_id": "7dc6543cbbdd3bcb1a9baa77da04a38d",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./output/cloud-site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DATA_BASE_URL": "https://kimhyuntae9665.github.io/sp500-quant-signal/data/"
  }
}
